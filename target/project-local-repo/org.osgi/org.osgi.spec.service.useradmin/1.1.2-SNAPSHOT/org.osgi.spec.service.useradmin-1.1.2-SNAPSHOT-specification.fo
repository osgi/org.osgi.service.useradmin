                     <fo:table-cell text-align="end" display-align="after" relative-align="baseline">
                        <fo:block>
                           <fo:block>OSGi Specification repo for org.osgi.service.useradmin</fo:block>
                        </fo:block>
                     </fo:table-cell>
                  </fo:table-row>
               </fo:table-body>
            </fo:table>
         </fo:block>
      </fo:static-content>
      <fo:flow flow-name="xsl-region-body" start-indent="1in" end-indent="0pt">
         <fo:block xmlns:d="http://docbook.org/ns/docbook"
                   xmlns:xlink="http://www.w3.org/1999/xlink"
                   break-after="page"/>
         <fo:block xmlns:d="http://docbook.org/ns/docbook"
