 The value of {@code USER} is 1.</fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.useradmin.Role.USER_ANYONE">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
