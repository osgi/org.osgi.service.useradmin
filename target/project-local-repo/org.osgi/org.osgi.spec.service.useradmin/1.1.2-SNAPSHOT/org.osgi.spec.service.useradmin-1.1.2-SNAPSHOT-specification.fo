         <fo:block id="d182e766">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Repository Maintenance</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>107.4</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Repository Maintenance</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">UserAdmin</fo:inline> interface is a straightforward API to
    maintain a repository of <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">User</fo:inline> and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Group</fo:inline> objects.
    It contains methods to create new <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Group</fo:inline> and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">User</fo:inline>
    objects with the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">createRole(String,int)</fo:inline> method. The method is
    prepared so that the same signature can be used to create new types of
    roles in the future. The interface also contains a method to remove a
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Role</fo:inline> object.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The existing configuration can be obtained with methods that list
    all <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Role</fo:inline> objects using a filter argument. This filter, which
    has the same syntax as the Framework filter, must only return the
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">Role</fo:inline> objects for which the filter matches the
    properties.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Several utility methods simplify getting <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">User</fo:inline> objects
    depending on their properties.</fo:block>
         </fo:block>
         <fo:block id="i1529238">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">User Admin Events</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>107.5</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>User Admin Events</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">Changes in the User Admin service can be determined in real time.
    Each User Admin service implementation must send a
    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">UserAdminEvent</fo:inline> object to any service in the Framework service
    registry that is registered under the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">UserAdminListener</fo:inline>
    interface. This event must be send asynchronously from the cause of the
    event. The way events must be delivered is the same as described in
    <fo:inline font-style="italic">Delivering Events</fo:inline> of <fo:inline color="inherit"
                          font-family="inherit"
                          letter-spacing="inherit"
                          hyphenate="inherit">???</fo:inline>.</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">This procedure is demonstrated in the following code sample.</fo:block>
            <fo:block space-before.minimum="0.8em"
                      space-before.optimum="1em"
                      space-before.maximum="1.2em"
                      space-after.minimum="0.8em"
                      space-after.optimum="1em"
                      space-after.maximum="1.2em"
                      hyphenate="false"
                      wrap-option="no-wrap"
                      white-space-collapse="false"
                      white-space-treatment="preserve"
                      linefeed-treatment="preserve"
                      text-align="start"
                      font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                      font-size="9pt"
                      letter-spacing="-.0em"
                      space-before="5pt"
                      space-after="3pt"
                      space-after.conditionality="retain"
                      start-indent="inherit"
                      line-height="11pt"
                      id="d182e808">class Listener implements UserAdminListener{
    public void roleChanged( UserAdminEvent event ) {
        ...
    }
}
public class MyActivator 
    implements BundleActivator {
    public void start( BundleContext context ) {
        context.registerService( 
            UserAdminListener.class.getName(),
            new Listener(), null );
    }
    public void stop( BundleContext context ) {}
}</fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">It is not necessary to unregister the listener object when the
    bundle is stopped because the Framework automatically unregisters it. Once
    registered, the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                          font-size="9pt"
                          letter-spacing="0.08em">UserAdminListener</fo:inline> object must be notified of
    all changes to the role repository.</fo:block>
            <fo:block id="d182e813">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.5.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Event Admin and User Admin Change Events</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">User Admin events must be delivered asynchronously to the Event
      Admin service by the implementation, if present. The topic of a User
      Admin Event is:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d182e816">org/osgi/service/useradmin/UserAdmin/&lt;eventtype&gt;</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The following event types are supported:</fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d182e818">ROLE_CREATED
ROLE_CHANGED
ROLE_REMOVED</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">All User Admin Events must have the following properties:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d182e820">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e821">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">event</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">UserAdminEvent</fo:inline>) The event
          that was broadcast by the User Admin service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e827">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">role</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Role</fo:inline>) The <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Role</fo:inline>
          object that was created, modified or removed.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e835">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">role.name</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String</fo:inline>) The name of the
          role.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e841">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">role.type</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Integer</fo:inline>) One of
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">ROLE, USER</fo:inline> or <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">GROUP</fo:inline>.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e851">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">ServiceReference</fo:inline>) The
          Service Reference of the User Admin service.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e857">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.id</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Long</fo:inline>) The User Admin
          service's ID.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e863">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.objectClass</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String[]</fo:inline>) The
          User Admin service's object class (which must include
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">org.osgi.service.useradmin.UserAdmin</fo:inline>)</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e871">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">service.pid</fo:inline> - (<fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">String)</fo:inline> The User
          Admin service's persistent identity</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
         </fo:block>
         <fo:block id="d182e877">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Security</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>107.6</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Security</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">The User Admin service is related to the security model of the OSGi
    framework, but is complementary to the <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                              xmlns:xlink="http://www.w3.org/1999/xlink"
                              internal-destination="i1307817">
                  <fo:inline color="inherit"
                             font-family="inherit"
                             letter-spacing="inherit"
                             hyphenate="inherit">[1] <fo:inline font-style="italic">The Java Security Architecture for JDK 1.2</fo:inline>
                  </fo:inline>
               </fo:basic-link>. The
    final permission of most code should be the intersection of the Java 2
    Permissions, which are based on the code that is executing, and the User
    Admin service authorization, which is based on the user for whom the code
    runs.</fo:block>
            <fo:block id="d182e883">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.6.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>User Admin Permission</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The User Admin service defines the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">UserAdminPermission</fo:inline> class that can be used to restrict
      bundles in accessing credentials. This permission class has the
      following actions:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d182e889">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e890">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">changeProperty</fo:inline> - This permission is required to
          modify properties. The name of the permission is the prefix of the
          property name.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e894">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">changeCredential</fo:inline> - This action permits changing
          credentials. The name of the permission is the prefix of the name of
          the credential.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e898">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">getCredential</fo:inline> - This action permits getting
          credentials. The name of the permission is the prefix of the
          credential.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">If the name of the permission is <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">"admin"</fo:inline>, it allows
      the owner to administer the repository. No action is associated with the
      permission in that case.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Otherwise, the permission name is used to match the property name.
      This name may end with a <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">".*"</fo:inline> string to indicate a
      wildcard. For example, <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">com.acme.*</fo:inline> matches
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">com.acme.fudd.elmer</fo:inline> and <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">com.acme.bugs</fo:inline>.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="d182e916">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">Relation to JAAS</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>107.7</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>Relation to JAAS</fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">At a glance, the Java Authorization and Authentication Service
    (JAAS) seems to be a very suitable model for user administration. The OSGi
    organization, however, decided to develop an independent User Admin
    service because JAAS was not deemed applicable. The reasons for this
    include dependency on Java SE version 1.3 ("JDK 1.3") and existing
    mechanisms in the previous OSGi Service Gateway 1.0 specification.</fo:block>
            <fo:block id="d182e919">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.7.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>JDK 1.3 Dependencies</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The authorization component of JAAS relies on the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">java.security.DomainCombiner</fo:inline> interface, which provides a
      means to dynamically update the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ProtectionDomain</fo:inline> objects
      affiliated with an <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">AccessControlContext</fo:inline> object.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">This interface was added in JDK 1.3. In the context of JAAS, the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">SubjectDomainCombiner</fo:inline> object, which implements the
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">DomainCombiner</fo:inline> interface, is used to update
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ProtectionDomain</fo:inline> objects. The permissions of
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ProtectionDomain</fo:inline> objects depend on where code came from and
      who signed it, with permissions based on who is running the code.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">Leveraging JAAS would have resulted in user-based access control
      on the OSGi framework being available only with JDK 1.3, which was not
      deemed acceptable.</fo:block>
            </fo:block>
            <fo:block id="d182e940">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.7.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Existing OSGi Mechanism</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">JAAS provides a plugable authentication architecture, which
      enables applications and their underlying authentication services to
      remain independent from each other.</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">The Servlet Whiteboard Specification already provides a similar feature by allowing
      servlet and resource registrations to be supported by an
      <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">ServletContextHelper</fo:inline> object, which uses a callback mechanism to
      perform any required authentication checks before granting access to the
      servlet or resource. This way, the registering bundle has complete
      control on a per-servlet and per-resource basis over which
      authentication protocol to use, how the credentials presented by the
      remote requester are to be validated, and who should be granted access
      to the servlet or resource.</fo:block>
            </fo:block>
            <fo:block id="d182e947">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.7.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Future Road Map</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">In the future, the main barrier of 1.3 compatibility will be
      removed. JAAS could then be implemented in an OSGi environment. At that
      time, the User Admin service will still be needed and will provide
      complementary services in the following ways:</fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d182e950">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e951">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The authorization component relies on group membership
          information to be stored and managed outside JAAS. JAAS does not
          manage persistent information, so the User Admin service can be a
          provider of group information when principals are assigned to a
          <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                         font-size="9pt"
                                         letter-spacing="0.08em">Subject</fo:inline> object.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e956">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>The authorization component allows for credentials to be
          collected and verified, but a repository is needed to actually
          validate the credentials.</fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">In the future, the User Admin service can act as the back-end
      database to JAAS. The only aspect JAAS will remove from the User Admin
      service is the need for the <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                             font-size="9pt"
                             letter-spacing="0.08em">Authorization</fo:inline> interface.</fo:block>
            </fo:block>
         </fo:block>
         <fo:block id="org.osgi.service.useradmin">
            <fo:block>
               <fo:block>
                  <fo:block keep-together.within-column="always"
                            margin-left="0pt"
                            font-family="ProductusSemibold,ArialUnicodeMS">
                     <fo:block keep-with-next.within-column="always">
                        <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                  xmlns:xlink="http://www.w3.org/1999/xlink"
                                  font-family="ProductusSemibold,ArialUnicodeMS"
                                  font-weight="normal"
                                  keep-with-next.within-column="always"
                                  space-before.minimum="0.8em"
                                  space-before.optimum="1.0em"
                                  space-before.maximum="1.2em"
                                  text-align="start"
                                  start-indent="0pt"
                                  hyphenate="false">
                           <fo:marker marker-class-name="section.head.marker">org.osgi.service.useradmin</fo:marker>
                           <fo:block font-size="18pt"
                                     line-height="25pt"
                                     space-before="12.5pt"
                                     space-after="12pt">
                              <fo:list-block provisional-distance-between-starts="1in"
                                             provisional-label-separation="0.090in">
                                 <fo:list-item>
                                    <fo:list-item-label end-indent="label-end()" text-align="start">
                                       <fo:block>107.8</fo:block>
                                    </fo:list-item-label>
                                    <fo:list-item-body start-indent="body-start()">
                                       <fo:block>org.osgi.service.useradmin<fo:inline id="org.osgi.service.useradmin-version"/>
                                       </fo:block>
                                    </fo:list-item-body>
                                 </fo:list-item>
                              </fo:list-block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block keep-together.within-column="always"/>
               </fo:block>
            </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
User Admin Package Version 1.1.
 
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Bundles wishing to use this package must list the package in the
 Import-Package header of the bundle's manifest. This package has two types of
 users: the consumers that use the API in this package and the providers that
 implement the API in this package.
 
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Example import for consumers using the API in this package:
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 {@code  Import-Package: org.osgi.service.useradmin; version="[1.1,2.0)"}
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 Example import for providers implementing the API in this package:
 </fo:block>
            <fo:block space-before.optimum="5pt"
                      space-before.minimum="5pt"
                      space-before.maximum="5pt">
 {@code  Import-Package: org.osgi.service.useradmin; version="[1.1,1.2)"}</fo:block>
            <fo:block id="d182e975">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.8.1</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>Summary</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:list-block space-before.optimum="1em"
                              space-before.minimum="0.8em"
                              space-before.maximum="1.2em"
                              space-after.optimum="1em"
                              space-after.minimum="0.8em"
                              space-after.maximum="1.2em"
                              provisional-label-separation="0.2em"
                              provisional-distance-between-starts="12pt"
                              id="d182e977">
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e978">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.Authorization">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">Authorization</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
The {@code Authorization} interface encapsulates an authorization context on
 which bundles can base authorization decisions, where appropriate.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e986">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.Group">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">Group</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
A named grouping of roles ({@code Role} objects).
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e994">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.Role">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">Role</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
The base interface for {@code Role} objects managed by the User Admin
 service.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e1002">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.User">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">User</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
A {@code User} role managed by a User Admin service.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e1010">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.UserAdmin">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">UserAdmin</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
This interface is used to manage a database of named {@code Role} objects,
 which can be used for authentication and authorization purposes.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e1018">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.UserAdminEvent">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">UserAdminEvent</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
{@code Role} change event.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e1026">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.UserAdminListener">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">UserAdminListener</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
Listener for UserAdminEvents.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
                  <fo:list-item space-before.optimum="2pt"
                                space-before.minimum="2pt"
                                space-before.maximum="2pt"
                                id="d182e1034">
                     <fo:list-item-label end-indent="label-end()">
                        <fo:block>•</fo:block>
                     </fo:list-item-label>
                     <fo:list-item-body start-indent="body-start()">
                        <fo:block>
                           <fo:block>
                              <fo:basic-link xmlns:d="http://docbook.org/ns/docbook"
                                             xmlns:xlink="http://www.w3.org/1999/xlink"
                                             internal-destination="org.osgi.service.useradmin.UserAdminPermission">
                                 <fo:inline color="inherit"
                                            font-family="inherit"
                                            letter-spacing="inherit"
                                            hyphenate="inherit">
                                    <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                               font-size="9pt"
                                               letter-spacing="0.08em">UserAdminPermission</fo:inline>
                                 </fo:inline>
                              </fo:basic-link> - 
Permission to configure and access the {@link Role} objects managed by a User
 Admin service.
   </fo:block>
                        </fo:block>
                     </fo:list-item-body>
                  </fo:list-item>
               </fo:list-block>
            </fo:block>
            <fo:block id="org.osgi.service.useradmin.Authorization">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.8.2</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public abstract Authorization</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
The {@code Authorization} interface encapsulates an authorization context on
 which bundles can base authorization decisions, where appropriate.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 Bundles associate the privilege to access restricted resources or operations
 with roles. Before granting access to a restricted resource or operation, a
 bundle will check if the {@code Authorization} object passed to it possess
 the required role, by calling its {@code hasRole} method.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 Authorization contexts are instantiated by calling the
 {@link UserAdmin#getAuthorization(User)} method.
 
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
                  <fo:inline font-style="italic">Trusting Authorization objects </fo:inline>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 There are no restrictions regarding the creation of {@code Authorization}
 objects. Hence, a service must only accept {@code Authorization} objects from
 bundles that has been authorized to use the service using code based (or Java
 2) permissions.
 
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 In some cases it is useful to use {@code ServicePermission} to do the code
 based access control. A service basing user access control on
 {@code Authorization} objects passed to it, will then require that a calling
 bundle has the {@code ServicePermission} to get the service in question. This
 is the most convenient way. The OSGi environment will do the code based
 permission check when the calling bundle attempts to get the service from the
 service registry.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 Example: A servlet using a service on a user's behalf. The bundle with the
 servlet must be given the {@code ServicePermission} to get the Http Service.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 However, in some cases the code based permission checks need to be more
 fine-grained. A service might allow all bundles to get it, but require
 certain code based permissions for some of its methods.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 Example: A servlet using a service on a user's behalf, where some service
 functionality is open to anyone, and some is restricted by code based
 permissions. When a restricted method is called (e.g., one handing over an
 {@code Authorization} object), the service explicitly checks that the calling
 bundle has permission to make the call.</fo:block>
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         start-indent="0pt"
                         relative-align="baseline">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block text-align="end" font-style="italic">
                              <fo:block>No Implement</fo:block>
                           </fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block>Consumers of this API must not implement this interface</fo:block>
                        </fo:list-item-body>
                     </fo:list-item>
                  </fo:list-block>
               </fo:block>
               <fo:block id="org.osgi.service.useradmin.Authorization.getName--">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>107.8.2.1</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract String getName()</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Gets the name of the {@link User} that this {@code Authorization} context
 was created for.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The name of the {@link User} object that this
         {@code Authorization} context was created for, or {@code null} if
         no user was specified when this {@code Authorization} context was
         created.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.useradmin.Authorization.getRoles--">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>107.8.2.2</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract String[][] getRoles()</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Gets the names of all roles implied by this {@code Authorization}
 context.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The names of all roles implied by this {@code Authorization}
         context, or {@code null} if no roles are in the context. The
         predefined role {@code user.anyone} will not be included in this
         list.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.useradmin.Authorization.hasRole-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>107.8.2.3</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public abstract boolean hasRole(String name)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>name</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>The name of the role to check for.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Checks if the role with the specified name is implied by this
 {@code Authorization} context.
 </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt">
 
 Bundles must define globally unique role names that are associated with
 the privilege of accessing restricted resources or operations. Operators
 will grant users access to these resources, by creating a {@link Group}
 object for each role and adding {@link User} objects to it.</fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Returns</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>{@code true} if this {@code Authorization} context implies the
         specified role, otherwise {@code false}.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
            </fo:block>
            <fo:block id="org.osgi.service.useradmin.Group">
               <fo:block>
                  <fo:block>
                     <fo:block keep-together.within-column="always"
                               margin-left="0pt"
                               font-family="ProductusSemibold,ArialUnicodeMS">
                        <fo:block keep-with-next.within-column="always">
                           <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                     xmlns:xlink="http://www.w3.org/1999/xlink"
                                     font-family="ProductusSemibold,ArialUnicodeMS"
                                     font-weight="normal"
                                     keep-with-next.within-column="always"
                                     space-before.minimum="0.8em"
                                     space-before.optimum="1.0em"
                                     space-before.maximum="1.2em"
                                     text-align="start"
                                     start-indent="0pt"
                                     hyphenate="false">
                              <fo:block font-size="12pt"
                                        line-height="14pt"
                                        space-before="8pt"
                                        space-after="5pt">
                                 <fo:list-block provisional-distance-between-starts="1in"
                                                provisional-label-separation="0.090in">
                                    <fo:list-item>
                                       <fo:list-item-label end-indent="label-end()" text-align="start">
                                          <fo:block>107.8.3</fo:block>
                                       </fo:list-item-label>
                                       <fo:list-item-body start-indent="body-start()">
                                          <fo:block>public abstract Group<fo:block line-height="0pt"/> extends User</fo:block>
                                       </fo:list-item-body>
                                    </fo:list-item>
                                 </fo:list-block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
               </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
A named grouping of roles ({@code Role} objects).
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 Whether or not a given {@code Authorization} context implies a {@code Group}
 object depends on the members of that {@code Group} object.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 A {@code Group} object can have two kinds of members: <fo:inline font-style="italic">basic </fo:inline> and
 <fo:inline font-style="italic">required </fo:inline>. A {@code Group} object is implied by an
 {@code Authorization} context if all of its required members are implied and
 at least one of its basic members is implied.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 A {@code Group} object must contain at least one basic member in order to be
 implied. In other words, a {@code Group} object without any basic member
 roles is never implied by any {@code Authorization} context.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 A {@code User} object always implies itself.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 No loop detection is performed when adding members to {@code Group} objects,
 which means that it is possible to create circular implications. Loop
 detection is instead done when roles are checked. The semantics is that if a
 role depends on itself (i.e., there is an implication loop), the role is not
 implied.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 The rule that a {@code Group} object must have at least one basic member to
 be implied is motivated by the following example:
 
 </fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d182e1102"> 
  group foo
    required members: marketing
    basic members: alice, bob</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 
 Privileged operations that require membership in "foo" can be performed only
 by "alice" and "bob", who are in marketing.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 If "alice" and "bob" ever transfer to a different department, anybody in
 marketing will be able to assume the "foo" role, which certainly must be
 prevented. Requiring that "foo" (or any {@code Group} object for that matter)
 must have at least one basic member accomplishes that.
 </fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 However, this would make it impossible for a {@code Group} object to be
 implied by just its required members. An example where this implication might
 be useful is the following declaration: "Any citizen who is an adult is
 allowed to vote." An intuitive configuration of "voter" would be:
 
 </fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d182e1107"> 
  group voter
    required members: citizen, adult
       basic members:</fo:block>
               <fo:block space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt">
 
 However, according to the above rule, the "voter" role could never be assumed
 by anybody, since it lacks any basic members. In order to address this issue
 a predefined role named "user.anyone" can be specified, which is always
 implied. The desired implication of the "voter" group can then be achieved by
 specifying "user.anyone" as its basic member, as follows:
 
 </fo:block>
               <fo:block space-before.minimum="0.8em"
                         space-before.optimum="1em"
                         space-before.maximum="1.2em"
                         space-after.minimum="0.8em"
                         space-after.optimum="1em"
                         space-after.maximum="1.2em"
                         hyphenate="false"
                         wrap-option="no-wrap"
                         white-space-collapse="false"
                         white-space-treatment="preserve"
                         linefeed-treatment="preserve"
                         text-align="start"
                         font-family="ProductusOSGiMonoc,ArialUnicodeMS"
                         font-size="9pt"
                         letter-spacing="-.0em"
                         space-before="5pt"
                         space-after="3pt"
                         space-after.conditionality="retain"
                         start-indent="inherit"
                         line-height="11pt"
                         id="d182e1109"> 
  group voter
    required members: citizen, adult
       basic members: user.anyone</fo:block>
               <fo:block xmlns:d="http://docbook.org/ns/docbook"
                         xmlns:xlink="http://www.w3.org/1999/xlink"
                         space-before.optimum="5pt"
                         space-before.minimum="5pt"
                         space-before.maximum="5pt"
                         start-indent="0pt"
                         relative-align="baseline">
                  <fo:list-block provisional-distance-between-starts="1in"
                                 provisional-label-separation="0.090in">
                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()" text-align="start">
                           <fo:block text-align="end" font-style="italic">
                              <fo:block>No Implement</fo:block>
                           </fo:block>
