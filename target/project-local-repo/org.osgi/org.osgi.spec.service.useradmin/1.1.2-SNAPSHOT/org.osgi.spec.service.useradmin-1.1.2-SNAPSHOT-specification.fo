               <fo:block id="org.osgi.service.useradmin.UserAdminPermission.UserAdminPermission-String-String-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>107.8.9.5</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public  UserAdminPermission(String name, String actions)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>name</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>the name of this {@code UserAdminPermission}</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>actions</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>the action string.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:inline font-weight="normal"
                                            font-style="normal"
                                            baseline-shift="-1pt"
                                            font-size="9pt">□</fo:inline>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
Creates a new {@code UserAdminPermission} with the specified name and
 actions. {@code name} is either the reserved string "admin" or
 the name of a credential or property, and {@code actions} contains a
 comma-separated list of the actions granted on the specified name. Valid
 actions are {@code changeProperty},{@code changeCredential}, and
 getCredential.
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
                            xmlns:xlink="http://www.w3.org/1999/xlink"
                            space-before.optimum="5pt"
                            space-before.minimum="5pt"
                            space-before.maximum="5pt"
                            start-indent="0pt"
                            relative-align="baseline">
                     <fo:list-block provisional-distance-between-starts="1in"
                                    provisional-label-separation="0.090in">
                        <fo:list-item>
                           <fo:list-item-label end-indent="label-end()" text-align="start">
                              <fo:block text-align="end" font-style="italic">
                                 <fo:block>Throws</fo:block>
                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
                                 <fo:inline font-family="ProductusOSGiBookc,ArialUnicodeMS"
                                            font-size="9pt"
                                            letter-spacing="0.08em">IllegalArgumentException</fo:inline>– If {@code name} equals "admin"
         and {@code actions} are specified.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
               <fo:block id="org.osgi.service.useradmin.UserAdminPermission.equals-Object-">
                  <fo:block>
                     <fo:block>
                        <fo:block keep-together.within-column="always"
                                  margin-left="0pt"
                                  font-family="ProductusSemibold,ArialUnicodeMS">
                           <fo:block keep-with-next.within-column="always">
                              <fo:block xmlns:d="http://docbook.org/ns/docbook"
                                        xmlns:xlink="http://www.w3.org/1999/xlink"
                                        font-family="ProductusSemibold,ArialUnicodeMS"
                                        font-weight="normal"
                                        keep-with-next.within-column="always"
                                        space-before.minimum="0.8em"
                                        space-before.optimum="1.0em"
                                        space-before.maximum="1.2em"
                                        text-align="start"
                                        start-indent="0pt"
                                        hyphenate="false">
                                 <fo:block font-size="9pt"
                                           line-height="11pt"
                                           space-before="5pt"
                                           space-after="5pt">
                                    <fo:list-block provisional-distance-between-starts="1in"
                                                   provisional-label-separation="0.090in">
                                       <fo:list-item>
                                          <fo:list-item-label end-indent="label-end()" text-align="start">
                                             <fo:block>107.8.9.6</fo:block>
                                          </fo:list-item-label>
                                          <fo:list-item-body start-indent="body-start()">
                                             <fo:block>public boolean equals(Object obj)</fo:block>
                                          </fo:list-item-body>
                                       </fo:list-item>
                                    </fo:list-block>
                                 </fo:block>
                              </fo:block>
                           </fo:block>
                        </fo:block>
                     </fo:block>
                  </fo:block>
                  <fo:block xmlns:d="http://docbook.org/ns/docbook"
